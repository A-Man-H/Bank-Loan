# Copy to `.env` and adjust as needed. All values have sensible defaults,
# so `docker compose up` works with no .env file at all.

# --- Database (consumed by the app via Main.java) ---
DB_URL=jdbc:mysql://db:3306/bank
DB_USER=root
DB_PASSWORD=
DB_HOST=db
DB_PORT=3306

# --- MySQL container ---
MYSQL_DATABASE=bank

# --- Display / access ports ---
SCREEN_GEOMETRY=1024x768x24
NOVNC_PORT=6080
VNC_PORT=5900
